# Configuración del cliente Supabase (Vite expone solo las variables VITE_*).
# Copia este archivo a .env y rellena los valores de tu proyecto.
#
# La anon key es PÚBLICA: aparece en el bundle del navegador. Con RLS activado
# (Fase 1) es aceptable tenerla en el cliente.
# NUNCA pongas aquí la service_role: solo debe vivir en el servidor / Edge Functions.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
